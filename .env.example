# Backend HTTP port
PORT=8080

# Base URL of the TCB CCIS system
TCB_BASE_URL=https://ccis.tcb.go.tz

# Database (Turso / libSQL).
# Leave blank to use a local SQLite file (./data/baletrack.sqlite) — zero setup.
# For a durable hosted database, set both of these from your Turso dashboard:
#   TURSO_DATABASE_URL=libsql://your-db-name.turso.io
#   TURSO_AUTH_TOKEN=your-token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Max concurrent confirm requests fired at the TCB server per job run
CONFIRM_CONCURRENCY=6

# Delay (ms) between individual confirm requests, per worker, to stay gentle on their server
CONFIRM_DELAY_MS=150

# Optional: simple shared password to open the app. Leave blank to disable auth.
APP_PASSWORD=
