# ── Set these in Vercel Dashboard → Settings → Environment Variables ──

# Neon (Vercel Postgres) — copy from your Neon dashboard
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Upstash Redis — copy from Upstash dashboard (use rediss:// for TLS)
REDIS_URL=rediss://default:your_token@your-endpoint.upstash.io:6379

# JWT secret — generate: openssl rand -hex 32
JWT_SECRET=your_32_byte_hex_secret_here

# Cloudflare R2 or AWS S3
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=auto
S3_BUCKET=skan-d
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# For MinIO on your server: http://your-server-ip:9000
S3_ENDPOINT=https://your-r2-or-s3-endpoint

# The public URL of your Vercel deployment (set after first deploy)
WEB_ORIGIN=https://your-app.vercel.app
