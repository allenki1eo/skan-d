{
  "name": "baletrack-auto",
  "version": "1.0.0",
  "private": true,
  "description": "Automatic cotton bale tracking for TCB CCIS — decode QR sheets and auto-confirm bales at the ginnery.",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/multipart": "^9.0.1",
    "@libsql/client": "^0.14.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "http-cookie-agent": "^6.0.8",
    "nanoid": "^5.0.9",
    "tough-cookie": "^5.0.0",
    "undici": "^7.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
