# PostgreSQL
POSTGRES_DB=skand
POSTGRES_USER=skand
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# Redis
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=skand_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_here

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_32_random_bytes_hex_here

# Web origin (your public domain or LAN IP)
WEB_ORIGIN=https://skan-d.yourdomain.com

# Worker scaling
DECODE_CONCURRENCY=8
DECODE_REPLICAS=2
PW_CONCURRENCY=20
PW_REPLICAS=3
